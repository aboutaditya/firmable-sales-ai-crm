# Application
APP_NAME="Sales Intelligence API"
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Analytical data
RAW_DATASET_URL=https://f001.backblazeb2.com/b2api/v1/b2_download_file_by_id?fileId=replace-me
ANALYTICAL_DATASET=data/processed/demo-companies.parquet
DATASET_RUNS_DIR=data/processed/dataset_runs

# Supabase/PostgreSQL
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# AI provider (used by assessment, summary, and outreach services)
LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=replace-me
LLM_HTTP_REFERER=http://localhost:3000
LLM_APP_TITLE="Sales Intelligence"
LLM_INPUT_COST_PER_1K=
LLM_OUTPUT_COST_PER_1K=
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
LLM_TRACE_PATH=data/traces/llm_calls.jsonl
AI_MIN_SCORE=0
AI_RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO

# OpenRouter evaluation settings
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE="Sales Intelligence Evaluation"
OPENROUTER_INPUT_COST_PER_1K=
OPENROUTER_OUTPUT_COST_PER_1K=

# Authentication
AUTH_REQUIRED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=replace-me
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Backend-only secret. Never expose this through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=replace-me
